<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>bang</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/bang</string>
    <string>-config</string>
    <string>__CONFIG__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- The address bar is unusable while this is down, so always restart it. -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
